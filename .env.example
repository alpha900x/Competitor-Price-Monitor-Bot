# --- AI Provider ---
ANTHROPIC_API_KEY=sk-ant-xxxxx
AI_MODEL=claude-sonnet-4-5
AI_MAX_RETRIES=2

# --- Slack ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# --- Alerting thresholds ---
PRICE_CHANGE_THRESHOLD_PCT=5.0

# --- Scraper ---
SCRAPER_TIMEOUT_SECONDS=30
SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; PriceMonitorBot/1.0)
PLAYWRIGHT_HEADLESS=true
SCRAPER_MAX_RETRIES=2

# --- Paths ---
DB_PATH=./data/products.db
PDF_STORAGE_DIR=./data/pdfs
REPORT_OUTPUT_DIR=./reports
TARGETS_CONFIG_PATH=./config/targets.json
LOG_FILE_PATH=./logs/run.log

# --- Scheduling (optional, if using scheduler.py instead of OS cron) ---
RUN_HOUR_UTC=6
USE_INTERNAL_SCHEDULER=false
